{
  "name": "imgbb-node",
  "version": "0.0.0",
  "description": "Lightweight ImgBB client for Node.js (and Bun) written in TypeScript with zero dependencies",
  "keywords": [
    "api",
    "bun",
    "client",
    "imgbb",
    "javascript",
    "library",
    "node",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/rgbpx/imgbb-node#readme",
  "bugs": {
    "url": "https://github.com/rgbpx/imgbb-node/issues",
    "email": "rgbpx@proton.me"
  },
  "license": "MIT",
  "author": {
    "name": "rgbpx",
    "email": "rgbpx@proton.me",
    "url": "https://github.com/rgbpx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgbpx/imgbb-node.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint ./src",
    "lint:fix": "oxlint --fix ./src",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.0.0",
    "@types/node": "^20.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": ">=22.18.0",
        "onFail": "error"
      },
      {
        "name": "bun",
        "version": ">=1.0.36",
        "onFail": "error"
      }
    ]
  },
  "engines": {
    "bun": ">=1.0.36",
    "node": ">=20.0.0"
  }
}
